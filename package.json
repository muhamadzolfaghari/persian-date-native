{
  "name": "persian-date-native",
  "version": "1.2.3",
  "description": "Ultra-fast, zero-dependency Persian (Jalali / Shamsi) date engine extending native JavaScript Date with Day.js plugin support.",
  "main": "dist/bundle.min.cjs.js",
  "module": "dist/bundle.min.esm.js",
  "types": "dist/index.d.ts",
  "homepage": "https://muhamadzolfaghari.github.io/persian-date-native/",
  "bugs": {
    "url": "https://github.com/muhamadzolfaghari/persian-date-native/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.min.esm.js",
      "require": "./dist/bundle.min.cjs.js",
      "default": "./dist/bundle.min.esm.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhamadzolfaghari/persian-date-native.git"
  },
  "scripts": {
    "start": "npm run watch",
    "start:demo": "cd ./demo && npm run watch",
    "test": "jest",
    "benchmark": "ts-node -O '{\"module\":\"commonjs\"}' ./scripts/benchmark.ts",
    "verify:build": "ts-node -O '{\"module\":\"commonjs\"}' ./scripts/verify-build.ts",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "demo": "ts-node demo/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "persian-date-native",
    "shamsi",
    "shamsi-date",
    "shamsi-converter",
    "shamsi-formatter",
    "shamsi-calendar",
    "persian",
    "persian-date",
    "persian-calendar",
    "persian-datepicker",
    "jalali",
    "jalali-date",
    "jalali-calendar",
    "jalaliday",
    "khorshidi",
    "hijri-shamsi",
    "tarikh-shamsi",
    "tabdil-tarikh",
    "dayjs",
    "dayjs-plugin",
    "dayjs-jalali",
    "moment-jalaali",
    "jalali-moment",
    "date-fns-jalali",
    "calendar",
    "date",
    "time",
    "iran",
    "farsi",
    "zero-dependency",
    "lightweight",
    "fast",
    "typescript",
    "relative-time",
    "from-now",
    "format"
  ],
  "author": {
    "name": "Mohammad Zolfaghari",
    "url": "https://github.com/muhamadzolfaghari"
  },
  "license": "ISC",
  "peerDependencies": {
    "dayjs": ">=1.10.0"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/jest": "^29.5.12",
    "dayjs": "^1.11.23",
    "jest": "^29.7.0",
    "rollup": "^4.21.3",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-watch": "^1.0.4",
    "shamsi": "^1.1.6",
    "ts-jest": "^29.2.4",
    "typescript": "^5.6.2"
  },
  "files": [
    "dist/"
  ]
}
